[Unit]
Description=Discovery Bridge LAN publication owner
After=avahi-daemon.service network-online.target
Requires=avahi-daemon.service
Wants=network-online.target
ConditionPathExists=/etc/discovery-bridge/router.json

[Service]
Type=notify
User=discovery-bridge-publisher
Group=discovery-bridge
UMask=0007
Environment=GOMAXPROCS=2
RuntimeDirectory=discovery-bridge
RuntimeDirectoryMode=0770
ExecStart=/usr/bin/discovery-bridge publisher --config /etc/discovery-bridge/router.json
WatchdogSec=3s
WatchdogSignal=SIGKILL
TimeoutStartSec=100s
TimeoutStopSec=2s
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
ProtectSystem=strict
ReadWritePaths=/var/lib/discovery-bridge
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
