# Build context: service_discovery/. Supply a reviewed digest-pinned base with
# Python >=3.13, pip, iproute2 and CA certificates already installed. No downloads.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG TARGETARCH
WORKDIR /app
COPY requirements.txt requirements-gateway.txt /app/
COPY build-inputs/wheels/ /wheels/
RUN python3 -m pip install --target=/opt/discovery-deps --no-cache-dir --no-index --find-links=/wheels --require-hashes -r requirements-gateway.txt \
    && rm -rf /wheels
# CLI binaries and SHA256SUMS must be verified against their release inputs before
# entering this context. These are standard upstream tools, not a Go application.
COPY build-inputs/${TARGETARCH}/bin/ /opt/discovery-bin/
RUN cd /opt/discovery-bin && sha256sum --strict --check SHA256SUMS \
    && install -m 0555 kubectl crictl /usr/bin/ \
    && rm -rf /opt/discovery-bin \
    && python3 -c 'import os; assert hasattr(os, "setns")' \
    && ip -Version && kubectl version --client=true && crictl --version
COPY discovery/ /app/discovery/
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/opt/discovery-deps
ENTRYPOINT ["python3", "-m", "discovery.node_runtime", "broker"]
