[Unit]
Description=Discovery Bridge independent mDNS publication owner (staged candidate)
After=avahi-daemon.service example-router-grow-var.service nftables.service systemd-networkd.service
Requires=avahi-daemon.service example-router-grow-var.service nftables.service systemd-networkd.service
ConditionPathExists=/etc/discovery-bridge/config.json

[Service]
Type=notify
User=discovery-bridge-publisher
Group=discovery-bridge
UMask=0007
RuntimeDirectory=discovery-bridge
RuntimeDirectoryMode=0770
WorkingDirectory=/usr/lib/discovery-bridge
# networkd being active does not mean the LAN addresses have completed setup.
ExecStartPre=/usr/lib/systemd/systemd-networkd-wait-online --interface=lan-vlan1:routable --interface=lan-vlan11:routable --interface=lan-vlan22:routable --interface=lan-vlan23:routable --interface=lan-vlan55:routable --interface=lan-vlan98:routable --ipv6 --timeout=90
TimeoutStartSec=100s
ExecStart=/usr/bin/python3 -m discovery.runtime publisher --config /etc/discovery-bridge/config.json --state /var/lib/discovery-bridge/identities.db --socket /run/discovery-bridge/publisher.sock --producer-user discovery-bridge-collector
WatchdogSec=3s
WatchdogSignal=SIGKILL
TimeoutStopSec=2s
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
ProtectSystem=strict
ReadWritePaths=/var/lib/discovery-bridge
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
MemoryMax=128M
TasksMax=32
